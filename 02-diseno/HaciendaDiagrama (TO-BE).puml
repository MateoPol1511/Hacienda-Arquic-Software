  ' --- Repositorios concretos (implementan IRepositorio*) --------
  class RepositorioPotrerosTexto <<infrastructure>> #F9E79F {
    - serializadorPotrero : ISerializador<Potrero>
    - serializadorRes : ISerializador<Res>
    - validadorPotrero : IValidadorPotrero
    - validadorRes : IValidadorRes
    + RepositorioPotrerosTexto(serializadorPotrero : ISerializador<Potrero>, serializadorRes : ISerializador<Res>, validadorPotrero : IValidadorPotrero, validadorRes : IValidadorRes)
    + ObtenerTodos() : List<Potrero>
    + ObtenerPorId(identificacion : string) : Potrero
    + Agregar(potrero : Potrero) : void
    + Existe(identificacion : string) : bool
  }
  RepositorioPotrerosTexto ..|> IRepositorioPotreros
  RepositorioPotrerosTexto "1" --> "1" IValidadorPotrero : valida antes de Agregar
  RepositorioPotrerosTexto "1" --> "1" IValidadorRes : valida antes de Agregar
  note bottom of RepositorioPotrerosTexto
    H-11/H-12: la validación que en el AS-IS hacía
    PersistenciaService mediante proxies de Castle
    DynamicProxy (InterceptorValidarInformacion) ahora
    es una llamada explícita del repositorio al
    validador correspondiente antes de persistir.
    Mismo comportamiento observable, sin AOP.
  end note

  class RepositorioVentasTexto <<infrastructure>> #F9E79F {
    - serializadorVenta : ISerializador<Venta>
    - validadorVenta : IValidadorVenta
    + RepositorioVentasTexto(serializadorVenta : ISerializador<Venta>, validadorVenta : IValidadorVenta)
    + ObtenerTodas() : List<Venta>
    + Agregar(venta : Venta) : void
  }
  RepositorioVentasTexto ..|> IRepositorioVentas
  RepositorioVentasTexto "1" --> "1" IValidadorVenta : valida antes de Agregar

  class RepositorioVacunasTexto <<infrastructure>> #F9E79F {
    - serializadorVacuna : ISerializador<Vacuna>
    - validadorVacuna : IValidadorVacuna
    + RepositorioVacunasTexto(serializadorVacuna : ISerializador<Vacuna>, validadorVacuna : IValidadorVacuna)
    + ObtenerDisponibles() : List<Vacuna>
    + Agregar(vacuna : Vacuna) : void
    + Remover(vacuna : Vacuna) : void
  }
  RepositorioVacunasTexto ..|> IRepositorioVacunas
  RepositorioVacunasTexto "1" --> "1" IValidadorVacuna : valida antes de Agregar

  class RepositorioUsuariosTexto <<infrastructure>> #F9E79F {
    - serializadorUsuario : ISerializador<Usuario>
    + ObtenerTodos() : List<Usuario>
    + BuscarPorNombre(nombre : string) : Usuario
    + Agregar(usuario : Usuario) : void
  }
  RepositorioUsuariosTexto ..|> IRepositorioUsuarios

  ' --- Hashing e interceptores ------------------------------------
  class ServicioHashSha256 <<infrastructure>> #F9E79F {
    + Hash(textoPlano : string) : string
    + Verificar(textoPlano : string, hash : string) : bool
  }
  ServicioHashSha256 ..|> IServicioHash

  note as NotaInterceptoresRetirados
    H-11/H-12 (auditoría): en el AS-IS,
    InterceptorAutenticacion e
    InterceptorValidarInformacion envolvían con Castle
    DynamicProxy a los proxies que creaba
    PersistenciaService. Al eliminarse PersistenciaService
    y pasar la validación a una dependencia explícita del
    repositorio (IValidador*, ver RepositorioPotrerosTexto/
    VentasTexto/VacunasTexto), el mecanismo de proxy
    dinámico deja de tener una clase que lo instancie y se
    retira: mismo comportamiento observable, sin AOP.
    Autorización: se conserva vía IAutenticacion/
    IProveedorPermisos + [Authorize] de ASP.NET Core en
    los controllers (ya presente en HomeController desde
    el AS-IS), sin necesitar un interceptor propio.
  end note
}

